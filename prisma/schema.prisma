// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TimelineEventType {
  CREATED
  ASSIGNED
  COMMENTED
  STATUS_CHANGED
  RESOLVED
}

model User {
  id        String @id @default(uuid())
  name      String
  email     String @unique 
  password  String 

  role      UserRole @default(USER)

  createdTickets   Ticket[] @relation("TicketCreatedBy")
  handledTickets   Ticket[] @relation("TicketHandledBy")

  comments  Comment[]

  timelines TicketTimeline[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Category {
  id          String @id @default(uuid())
  name        String @unique
  description String?

  tickets     Ticket[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("categories")
}

model Ticket {
  id          String @id @default(uuid())

  title       String
  description String
  code        String

  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])

  priority    TicketPriority @default(LOW)
  status      TicketStatus @default(OPEN)

  createdById String
  createdBy   User @relation("TicketCreatedBy", fields: [createdById], references: [id])

  handledById String?
  handledBy   User? @relation("TicketHandledBy", fields: [handledById], references: [id])

  comments    Comment[]

  timelines   TicketTimeline[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("tickets")
}

model Comment {
  id        String    @id @default(uuid())
  body      String

  ticketId  String
  ticket    Ticket    @relation(fields: [ticketId], references: [id])

  userId    String
  user      User      @relation(fields: [userId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("comments")
}

model TicketTimeline {
  id          String @id @default(uuid())

  title       String
  description String

  ticketId    String
  ticket      Ticket  @relation(fields: [ticketId], references: [id])

  userId      String
  user        User    @relation(fields: [userId], references: [id])

  eventType   TimelineEventType

  createdAt   DateTime @default(now())

  @@map("ticket_timelines")
}